{
  "name": "sirce-nuxt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "nuxt dev",
    "electron": "electron .",
    "db:start": "powershell -ExecutionPolicy Bypass -File herramientas/iniciar-postgres.ps1",
    "dev:postgres": "powershell -ExecutionPolicy Bypass -File herramientas/iniciar-proyecto.ps1",
    "pilot:install": "powershell -ExecutionPolicy Bypass -File herramientas/instalar-piloto.ps1",
    "pilot:start": "powershell -ExecutionPolicy Bypass -File herramientas/iniciar-piloto.ps1",
    "db:backup": "powershell -ExecutionPolicy Bypass -File herramientas/respaldar-base.ps1",
    "build": "nuxt build",
    "installer": "npm run build && electron-builder --win nsis --x64 --config.directories.output=release\\installer-build && powershell -NoProfile -ExecutionPolicy Bypass -File herramientas/copiar-instalador-escritorio.ps1",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "node --test pruebas/*.test.mjs"
  },
  "build": {
    "appId": "com.clubsystems.desktop",
    "productName": "Club Systems",
    "executableName": "ClubSystems",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "desktop/assets"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "!desktop/seed/**"
    ],
    "extraResources": [
      {
        "from": ".output",
        "to": ".output",
        "filter": [
          "**/*",
          "!.data/**"
        ]
      },
      {
        "from": "herramientas/configurar-equipo-cliente.ps1",
        "to": "configurar-equipo-cliente.ps1"
      },
      {
        "from": "herramientas/Vincular-Equipo.ps1",
        "to": "Vincular-Equipo.ps1"
      },
      {
        "from": "herramientas/Permitir-Red-Privada.ps1",
        "to": "Permitir-Red-Privada.ps1"
      },
      {
        "from": "herramientas/Vincular-Red.cmd",
        "to": "Vincular-Red.cmd"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/club-systems.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Club Systems",
      "artifactName": "ClubSystems-Setup.${ext}"
    }
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "jspdf": "^3.0.4",
    "jszip": "^3.10.1",
    "nuxt": "^4.0.0",
    "pg": "^8.23.0",
    "vue": "^3.5.22",
    "vue-router": "5.3.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.10",
    "@types/pg": "^8.23.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "mysql2": "^3.15.3",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.1.4"
  },
  "allowScripts": {
    "core-js@3.47.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
